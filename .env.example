# copy this file to .env and fill in your own values
PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/BookMyShow
CLIENT_URL=http://localhost:3000

# any long random strings (different from each other)
ACCESS_TOKEN_SECRET=change-this-to-a-long-random-string
REFRESH_TOKEN_SECRET=change-this-to-another-long-random-string

# GitHub login - make an OAuth App in GitHub > Settings > Developer settings
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback
